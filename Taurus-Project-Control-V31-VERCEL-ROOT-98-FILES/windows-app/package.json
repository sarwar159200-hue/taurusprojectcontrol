{
  "name": "taurus-project-control-windows",
  "version": "1.0.0",
  "private": true,
  "description": "Taurus Project Control Windows desktop client",
  "main": "main.cjs",
  "scripts": {
    "build:x64": "electron-builder --win nsis --x64",
    "build:ia32": "electron-builder --win nsis --ia32"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.taurusenergy.projectcontrol",
    "productName": "Taurus Project Control",
    "artifactName": "Taurus-Project-Control-Windows-${arch}-${version}.${ext}",
    "files": [
      "main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taurus Project Control"
    }
  }
}
